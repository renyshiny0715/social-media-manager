# ===== Required =====

# OpenAI API key (platform.openai.com) — drafts the posts (GPT-5) AND generates images (gpt-image-1)
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_MODEL=gpt-5          # text model for drafting
# OPENAI_IMAGES=off           # set to "off" to skip AI images and always use the template card

# GitHub datastore: a fine-grained token with Contents read/write on the repo below
GITHUB_TOKEN=
GITHUB_REPO=owner/social-media-manager
GITHUB_BRANCH=main

# Gmail: your address + an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_TO=

# App: public URL after deploying to Vercel, plus two random secrets
# (generate each with: openssl rand -hex 32)
APP_URL=https://your-app.vercel.app
APP_SECRET=
CRON_SECRET=

# How many candidate drafts per email
DRAFTS_PER_RUN=3

# ===== X (Twitter) publishing =====
# developer.x.com -> create app -> Keys & Tokens.
# Access token must have Read+Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ===== LinkedIn publishing =====
# linkedin.com/developers -> create app -> add products "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect".
# Then visit /api/linkedin/auth?secret=<APP_SECRET> to get the token + URN below.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
